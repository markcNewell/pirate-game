; Engine configuration file.
; Edited by hand and by Claude; keep keys sorted by section like the editor writes them.

config_version=5

[application]

config/name="Pirate Game"
config/version="0.1.0"
run/main_scene="res://game/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Net="*res://game/net/net.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="deck_proxy"

[physics]

common/physics_ticks_per_second=60

[rendering]

rendering_device/fallback_to_opengl3=true
anti_aliasing/quality/msaa_3d=2
