; Engine configuration file.
; Edited by hand and by Claude; keep keys sorted by section like the editor writes them.

config_version=5

[application]

config/name="Sea of Slop"
config/version="0.3.1"
run/main_scene="res://game/main.tscn"
boot_splash/bg_color=Color(0.105882, 0.101961, 0.141176, 1)
boot_splash/image="res://art/icon/splash.png"
boot_splash/fullsize=false
config/icon="res://art/icon/icon.svg"
config/features=PackedStringArray("4.7", "Forward Plus")

[audio]

driver/enable_input=true

[autoload]

Net="*res://game/net/net.gd"
Audio="*res://game/audio/audio.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="deck_proxy"

[physics]

common/physics_ticks_per_second=60

[rendering]

rendering_device/fallback_to_opengl3=true
anti_aliasing/quality/msaa_3d=2
textures/vram_compression/import_etc2_astc=true
